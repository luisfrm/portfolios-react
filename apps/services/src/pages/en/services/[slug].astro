---
import ServiceView from "@/views/ServiceView.astro";
import { services } from "@/data/services";
import { serviceKeyForLocale } from "@/lib/routes";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slugs.en },
  }));
}

const slug = Astro.params.slug ?? "";
const serviceKey = serviceKeyForLocale("en", slug);

if (!serviceKey) {
  throw new Error(`Unknown service slug: ${slug}`);
}
---

<ServiceView locale="en" serviceKey={serviceKey} />
