{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-services",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "servicios.luisrivas.site",
      "custom_domain": true
    }
  ]
}
